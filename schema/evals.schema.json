{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "vars", "assert"],
        "properties": {
          "name": { "type": "string" },
          "vars": { "type": "object" },
          "assert": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["contains", "not_contains", "regex", "is_json", "json_schema", "max_chars"] },
                "value": {},
                "case_sensitive": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    }
  }
}
